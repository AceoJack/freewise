# Copy to .env and fill in. Never commit .env.
PORT=3000
# 127.0.0.1 = only reachable through Tailscale Funnel / localhost, not the LAN
HOST=127.0.0.1
GOOGLE_CLIENT_ID=
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Who can sign in: "Name:email[,email...]" for each person, separated by ";"
FREEWISE_USERS=Jack:jack@gmail.com;Jaime:jaime@gmail.com,jaime.alt@gmail.com
DB_PATH=./data/freewise.db

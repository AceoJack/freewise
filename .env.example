# Copy to .env and fill in. Never commit .env.
PORT=3000
# 127.0.0.1 = only reachable through Tailscale Funnel / localhost, not the LAN
HOST=127.0.0.1
GOOGLE_CLIENT_ID=
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# People who can always sign in: "Name:email[,email...]" for each person, separated by ";".
# Anyone else can sign in once a friend adds their email in the app.
FREEWISE_USERS=Jack:jack@gmail.com;Jaime:jaime@gmail.com,jaime.alt@gmail.com
DB_PATH=./data/freewise.db
# Adds "Sign in as ..." buttons for local development. Refused when NODE_ENV=production.
DEV_LOGIN=false
# Set to production on the Pi (enables Secure cookies)
NODE_ENV=development
